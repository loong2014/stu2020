<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.sunny.module.stu">

    <!-- Server端# 定义权限，并指定了其保护级别为 "signature"这意味着只有与服务端应用有相同签名的应用才能获得这个权限。-->
    <permission android:name="com.sunny.demo.service.MY_PERMISSION"
        android:protectionLevel="signature" />

    <!-- Client端# 由于 Server端 做了权限限制，要使用服务必须申请下面的权限 -->
    <uses-permission android:name="com.sunny.demo.service.MY_PERMISSION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Family">
        <activity android:name=".StuDemoActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".introduction.StuIntroductionActivity"
            android:launchMode="singleTask" />
        <activity android:name=".book.StuBook01Activity" />
<!--        <activity android:name="com.sunny.module.dragger.StuDaggerActivity" />-->

        <service android:name=".BAndroid.ABinder.demo.SunnyService">

        </service>
    </application>

</manifest>